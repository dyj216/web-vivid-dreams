{
  "name": "web-vivid-dreams",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "eslint src/app",
    "e2e": "ng e2e",
    "build:pages": "ng build -c production --base-href /web-vivid-dreams/ && cp pages/index.html pages/404.html docs/",
    "deploy": "npm run build:pages && ngh --dir=docs --no-notfound --no-silent --message \"Deploy $(git rev-parse --short HEAD)\""
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.3.0",
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/localize": "^22.3.0",
    "@angular/material": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "ngx-countdown": "^22.0.0",
    "rxjs": "^7.5.5",
    "tslib": "^2.3.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@angular/language-service": "^22.3.0",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^26.6.11",
    "angular-cli-ghpages": "^3.1.2",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
